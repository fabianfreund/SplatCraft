{
  "name": "@splatcraft/desktop",
  "productName": "SplatCraft",
  "version": "0.1.3",
  "description": "Cross-platform Gaussian Splatting studio",
  "author": "Fabian Builds",
  "homepage": "https://github.com/fabianfreund/SplatCraft",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sparkjsdev/spark": "^2.4.0",
    "@splatcraft/core": "workspace:*",
    "@splatcraft/plugins": "workspace:*",
    "@splatcraft/toolchain": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.0",
    "zustand": "^5.1.0"
  }
}
